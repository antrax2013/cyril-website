{
	"name": "cyril-cophignon-net",
	"private": true,
	"version": "1.3.2",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"generate": "tsc && vite build",
		"build": "tsc && vite build",
		"lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
		"preview": "vite preview",
		"compile-sass": "sass --watch src/scss/:public/css --no-source-map -s compressed",
		"postbuild": "react-spa-prerender && powershell -File .\\post-build.ps1 -m cyril.cophignon.net",
		"purge": "purgecss -v --config config/purgecss.config.js"
	},
	"overrides": {
		"node-fetch": "^2.6.7"
	},
	"dependencies": {
		"@emailjs/browser": "^4.4.1",
		"formik": "^2.4.6",
		"primeflex": "^4.0.0",
		"primeicons": "^7.0.0",
		"primereact": "^10.9.7",
		"react": "19.0.0",
		"react-dom": "19.0.0",
		"react-router-dom": "^7.2.0"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@types/react": "^19.0.10",
		"@types/react-dom": "^19.0.4",
		"@typescript-eslint/eslint-plugin": "^8.24.1",
		"@typescript-eslint/parser": "^8.24.1",
		"@vitejs/plugin-react-swc": "^3.5.0",
		"eslint": "^9.27.0",
		"eslint-plugin-react-hooks": "^5.1.0",
		"eslint-plugin-react-refresh": "^0.4.19",
		"purgecss": "^7.0.2",
		"react-spa-prerender": "^1.0.1",
		"sass": "^1.89.0",
		"stylelint": "^16.25.0",
		"stylelint-prettier": "^5.0.3",
		"typescript": "^5.8.3",
		"vite": "^6.3.5"
	}
}
